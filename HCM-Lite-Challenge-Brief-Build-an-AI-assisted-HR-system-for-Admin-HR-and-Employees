<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HCM Lite — Human Capital Management</title>
<style>
:root{--navy:#14213d;--blue:#3157d5;--bg:#f4f6fb;--card:#fff;--text:#172033;--muted:#6d7890;--line:#e5e9f2;--green:#16845b;--red:#c43b4d;--amber:#a76a09}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font:14px/1.5 Inter,Segoe UI,Arial,sans-serif;color:var(--text)}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:9px;padding:10px 14px;background:var(--blue);color:#fff;font-weight:650}button.secondary{background:#edf1ff;color:var(--blue)}button.danger{background:#fff0f1;color:var(--red)}button:disabled{opacity:.45;cursor:not-allowed}
.app{display:grid;grid-template-columns:235px 1fr;min-height:100vh}.sidebar{background:var(--navy);color:#fff;padding:24px 15px;display:flex;flex-direction:column;gap:20px}.brand{display:flex;gap:11px;align-items:center;padding:0 9px 14px;border-bottom:1px solid #ffffff22}.logo{display:grid;place-items:center;background:#5675ef;border-radius:12px;width:39px;height:39px;font-weight:900;font-size:19px}.brand strong{display:block;font-size:18px}.brand small{color:#bac5e3}.nav-label{font-size:10px;letter-spacing:1.5px;color:#9eaccd;padding:0 12px}.nav{display:grid;gap:5px}.nav button{display:flex;align-items:center;gap:12px;text-align:left;background:transparent;color:#c7d0e7;font-weight:550}.nav button.active,.nav button:hover{background:#ffffff18;color:#fff}.nav .ico{width:21px;text-align:center;font-size:16px}.side-note{margin-top:auto;color:#aebbd9;font-size:12px;padding:12px;border:1px solid #ffffff22;border-radius:12px}.main{min-width:0}.topbar{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px;gap:15px}.topbar h2{margin:0;font-size:19px}.topbar p{margin:2px 0 0;color:var(--muted);font-size:12px}.user-pill{display:flex;align-items:center;gap:10px;font-weight:650}.avatar{width:36px;height:36px;display:grid;place-items:center;background:#e8edff;color:var(--blue);border-radius:50%;font-weight:800}.content{padding:28px;max-width:1500px;margin:auto}.page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:22px}.page-head h1{margin:0 0 5px;font-size:25px;letter-spacing:-.5px}.page-head p{margin:0;color:var(--muted)}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:22px}.stat,.panel{background:var(--card);border:1px solid var(--line);border-radius:15px;padding:20px;box-shadow:0 3px 12px #1b2a4a05}.stat-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-weight:600}.stat-icon{background:#edf1ff;color:var(--blue);width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-size:18px}.stat-number{font-size:30px;font-weight:800;letter-spacing:-1px;margin-top:14px}.stat-sub{font-size:12px;color:var(--muted);margin-top:2px}.grid2{display:grid;grid-template-columns:1.2fr .8fr;gap:17px}.panel{margin-bottom:17px}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:17px}.panel h3{font-size:15px;margin:0}.muted{color:var(--muted)}.empty{padding:35px 15px;text-align:center;color:var(--muted)}.empty .empty-icon{font-size:28px;margin-bottom:8px}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;white-space:nowrap}th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);font-weight:700;background:#fafbfe}td,th{padding:13px 12px;border-bottom:1px solid var(--line)}td{font-size:13px}tbody tr:last-child td{border-bottom:0}.badge{display:inline-block;border-radius:20px;padding:4px 9px;font-size:11px;font-weight:750;background:#eef1f7;color:#68748a}.badge.green{background:#e4f7ee;color:var(--green)}.badge.red{background:#ffebee;color:var(--red)}.badge.amber{background:#fff3dc;color:var(--amber)}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:12px;font-weight:700;color:#4e5a72}.field input,.field select,.field textarea,.search{width:100%;border:1px solid #dce2ee;border-radius:9px;padding:11px 12px;background:#fff;color:var(--text);outline:none}.field input:focus,.field select:focus,.field textarea:focus,.search:focus{border-color:#7188ef;box-shadow:0 0 0 3px #3157d515}.actions{display:flex;gap:8px;flex-wrap:wrap}.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:15px}.toolbar .search{max-width:330px}.toolbar select{border:1px solid var(--line);border-radius:9px;padding:10px;background:#fff}.notice{padding:12px 14px;background:#eef3ff;color:#3451aa;border-radius:10px;margin-bottom:17px;font-size:13px}.danger-note{background:#fff3dc;color:#8a5a08}.hidden{display:none!important}.chat{display:flex;flex-direction:column;gap:12px}.chat-log{height:320px;overflow:auto;padding:15px;background:#f8f9fd;border-radius:12px;border:1px solid var(--line);display:flex;flex-direction:column;gap:10px}.bubble{max-width:88%;padding:11px 13px;border-radius:12px;white-space:pre-wrap}.bubble.bot{background:#fff;border:1px solid var(--line);align-self:flex-start}.bubble.me{background:var(--blue);color:#fff;align-self:flex-end}.chat-form{display:flex;gap:8px}.chat-form input{flex:1;min-width:0;border:1px solid var(--line);border-radius:9px;padding:12px}.quick-questions{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.quick-questions button{font-size:12px;padding:8px 10px}.toast{position:fixed;bottom:20px;right:20px;background:#172033;color:#fff;padding:12px 18px;border-radius:10px;box-shadow:0 8px 30px #0002;z-index:10}.footer{font-size:11px;color:var(--muted);text-align:center;padding:10px}.hamb{display:none;background:#eef1ff;color:var(--blue)}.setup-banner{background:linear-gradient(120deg,#1b2b52,#3157d5);color:#fff;border-radius:15px;padding:22px;margin-bottom:20px}.setup-banner h2{margin:0 0 5px}.setup-banner p{margin:0;color:#e1e7ff}.setup-banner button{background:#fff;color:#2949c1;margin-top:14px}
@media(max-width:900px){.app{grid-template-columns:1fr}.sidebar{display:none;position:fixed;z-index:5;inset:0 auto 0 0;width:235px}.sidebar.open{display:flex}.hamb{display:inline-block}.topbar{padding:0 16px}.content{padding:18px}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.grid2{grid-template-columns:1fr}}
@media(max-width:520px){.stats{gap:9px}.stat{padding:14px}.stat-number{font-size:25px}.content{padding:13px}.topbar{height:66px}.page-head h1{font-size:21px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.user-pill span{display:none}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar" id="sidebar">
  <div class="brand"><div class="logo">H</div><div><strong>HCM Lite</strong><small>People operations</small></div></div>
  <div class="nav-label">WORKSPACE</div>
  <nav class="nav" id="nav">
    <button class="active" data-page="dashboard"><span class="ico">▦</span>Dashboard</button>
    <button data-page="employees"><span class="ico">♙</span>Employees</button>
    <button data-page="attendance"><span class="ico">◷</span>Attendance</button>
    <button data-page="leaves"><span class="ico">▣</span>Leave management</button>
    <button data-page="company"><span class="ico">⌂</span>Company setup</button>
    <button data-page="assistant"><span class="ico">✦</span>AI HR assistant</button>
  </nav>
  <div class="side-note"><strong>Privacy first</strong><br>Data is stored in this browser on this device. No demo records are preloaded.</div>
</aside>
<main class="main">
  <header class="topbar">
    <div style="display:flex;align-items:center;gap:12px"><button class="hamb" id="hamb">☰</button><div><h2 id="topTitle">Dashboard</h2><p id="companySubtitle">Your people, at a glance</p></div></div>
    <div class="user-pill"><div class="avatar">HR</div><span>Admin / HR</span></div>
  </header>
  <div class="content">
    <section id="page-dashboard" class="page">
      <div id="setupPrompt"></div>
      <div class="page-head"><div><h1>Good to see you 👋</h1><p>Here’s what’s happening across your workforce.</p></div><button onclick="showPage('employees')">＋ Add employee</button></div>
      <div class="stats">
        <div class="stat"><div class="stat-top"><span>Total employees</span><span class="stat-icon">♙</span></div><div class="stat-number" id="statEmployees">0</div><div class="stat-sub">Registered employee records</div></div>
        <div class="stat"><div class="stat-top"><span>Departments</span><span class="stat-icon">▤</span></div><div class="stat-number" id="statDepartments">0</div><div class="stat-sub">Company departments</div></div>
        <div class="stat"><div class="stat-top"><span>Present today</span><span class="stat-icon">✓</span></div><div class="stat-number" id="statPresent">0</div><div class="stat-sub" id="presentSub">Attendance marked today</div></div>
        <div class="stat"><div class="stat-top"><span>Pending leaves</span><span class="stat-icon">◷</span></div><div class="stat-number" id="statLeaves">0</div><div class="stat-sub">Awaiting HR decision</div></div>
      </div>
      <div class="grid2">
        <div class="panel"><div class="panel-head"><h3>Recent employees</h3><button class="secondary" onclick="showPage('employees')">View all</button></div><div id="recentEmployees"></div></div>
        <div class="panel"><div class="panel-head"><h3>Today’s attendance</h3><button class="secondary" onclick="showPage('attendance')">Manage</button></div><div id="todayAttendance"></div></div>
      </div>
      <div class="panel"><div class="panel-head"><h3>Recent leave requests</h3><button class="secondary" onclick="showPage('leaves')">Review leaves</button></div><div id="recentLeaves"></div></div>
    </section>

    <section id="page-company" class="page hidden">
      <div class="page-head"><div><h1>Company setup</h1><p>Start with your organization details and departments.</p></div></div>
      <div class="notice">New workspace: there are no employees, attendance entries, or leave requests until your team creates them.</div>
      <div class="panel"><div class="panel-head"><h3>Organization profile</h3></div>
        <form id="companyForm"><div class="form-grid">
          <div class="field"><label>Company name *</label><input id="companyName" required placeholder="e.g. Acme Technologies"></div>
          <div class="field"><label>Admin / HR contact</label><input id="companyContact" placeholder="HR manager name"></div>
          <div class="field"><label>Work email</label><input id="companyEmail" type="email" placeholder="hr@company.com"></div>
          <div class="field"><label>Office location</label><input id="companyLocation" placeholder="City, country"></div>
          <div class="field full"><label>Departments (comma separated)</label><input id="departmentInput" placeholder="Human Resources, Engineering, Sales"></div>
        </div><div class="actions" style="margin-top:18px"><button type="submit">Save company setup</button><button type="button" class="secondary" onclick="loadCompanyForm()">Reset form</button></div></form>
      </div>
      <div class="panel"><div class="panel-head"><h3>Manage departments</h3></div><form id="departmentForm" class="toolbar"><input class="search" id="newDepartment" placeholder="New department name" required><button>Add department</button></form><div id="departmentList"></div></div>
    </section>

    <section id="page-employees" class="page hidden">
      <div class="page-head"><div><h1>Employees</h1><p>Maintain your employee directory. Records are only created when you register them.</p></div><button onclick="document.getElementById('employeeName').focus()">＋ Register employee</button></div>
      <div class="panel"><div class="panel-head"><h3 id="employeeFormTitle">Register a new employee</h3></div>
        <form id="employeeForm"><input type="hidden" id="employeeId"><div class="form-grid">
          <div class="field"><label>Full name *</label><input id="employeeName" required placeholder="Employee full name"></div>
          <div class="field"><label>Work email *</label><input id="employeeEmail" type="email" required placeholder="name@company.com"></div>
          <div class="field"><label>Department *</label><select id="employeeDepartment" required><option value="">Set up a department first</option></select></div>
          <div class="field"><label>Job title</label><input id="employeeTitle" placeholder="e.g. Software Engineer"></div>
          <div class="field"><label>Joining date *</label><input id="employeeJoinDate" type="date" required></div>
          <div class="field"><label>Employment status</label><select id="employeeStatus"><option>Active</option><option>Onboarding</option><option>Inactive</option></select></div>
        </div><div class="actions" style="margin-top:16px"><button type="submit">Save employee</button><button type="button" class="secondary" onclick="resetEmployeeForm()">Clear form</button></div></form>
      </div>
      <div class="panel"><div class="panel-head"><h3>Employee directory</h3><span class="muted" id="employeeCount">0 records</span></div><div class="toolbar"><input class="search" id="employeeSearch" placeholder="Search name, email, department…"><select id="employeeFilter"><option value="">All departments</option></select></div><div id="employeeTable"></div></div>
    </section>

    <section id="page-attendance" class="page hidden">
      <div class="page-head"><div><h1>Attendance</h1><p>Record daily attendance for registered employees.</p></div></div>
      <div class="panel"><div class="panel-head"><h3>Mark attendance</h3><input id="attendanceDate" type="date" class="search" style="max-width:180px"></div><div id="attendanceEditor"></div></div>
      <div class="panel"><div class="panel-head"><h3>Attendance records</h3><span class="muted" id="attendanceCount">0 records</span></div><div class="toolbar"><input id="attendanceSearch" class="search" placeholder="Search employee…"><input id="attendanceHistoryDate" type="date" class="search" style="max-width:180px"></div><div id="attendanceTable"></div></div>
    </section>

    <section id="page-leaves" class="page hidden">
      <div class="page-head"><div><h1>Leave management</h1><p>Submit leave requests and review their status.</p></div></div>
      <div class="panel"><div class="panel-head"><h3>New leave request</h3></div><form id="leaveForm"><div class="form-grid">
        <div class="field"><label>Employee *</label><select id="leaveEmployee" required><option value="">Register an employee first</option></select></div>
        <div class="field"><label>Leave type *</label><select id="leaveType"><option>Annual leave</option><option>Sick leave</option><option>Personal leave</option><option>Unpaid leave</option></select></div>
        <div class="field"><label>Start date *</label><input id="leaveStart" type="date" required></div>
        <div class="field"><label>End date *</label><input id="leaveEnd" type="date" required></div>
        <div class="field full"><label>Reason</label><textarea id="leaveReason" rows="2" placeholder="Optional reason for leave"></textarea></div>
      </div><div class="actions" style="margin-top:16px"><button type="submit">Submit leave request</button></div></form></div>
      <div class="panel"><div class="panel-head"><h3>Leave requests</h3><span class="muted" id="leaveCount">0 requests</span></div><div class="toolbar"><select id="leaveFilter"><option value="">All statuses</option><option>Pending</option><option>Approved</option><option>Rejected</option></select></div><div id="leaveTable"></div></div>
    </section>

    <section id="page-assistant" class="page hidden">
      <div class="page-head"><div><h1>AI HR assistant</h1><p>Ask questions about the records saved in this workspace.</p></div></div>
      <div class="notice">This standalone HTML version uses a local, data-grounded assistant with no external AI connection. It answers supported questions from saved records and will not invent missing company data.</div>
      <div class="panel"><div class="chat"><div class="chat-log" id="chatLog"><div class="bubble bot">Hi! I can answer questions using the data in this HCM Lite workspace. Try “How many employees do we have?”, “Who is present today?”, or “How many leaves are pending?”</div></div><form class="chat-form" id="chatForm"><input id="chatInput" autocomplete="off" placeholder="Ask about employees, attendance, departments or leaves…" required><button>Ask</button></form></div>
      <div class="quick-questions"><button class="secondary" data-question="How many employees do we have?">Employee count</button><button class="secondary" data-question="Who is present today?">Present today</button><button class="secondary" data-question="How many leaves are pending?">Pending leaves</button><button class="secondary" data-question="Show department summary">Department summary</button></div></div>
    </section>
    <div class="footer">HCM Lite · Your workspace starts empty · Browser-local prototype</div>
  </div>
</main>
</div>
<div id="toast" class="toast hidden"></div>
<script>
const KEY='hcm_lite_v1';
const today=()=>new Date().toLocaleDateString('en-CA');
const uid=()=>crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2);
const fresh=()=>({company:{name:'',contact:'',email:'',location:''},departments:[],employees:[],attendance:[],leaves:[]});
let db;
try{db=JSON.parse(localStorage.getItem(KEY))||fresh()}catch(e){db=fresh()}
function save(){localStorage.setItem(KEY,JSON.stringify(db));renderAll()}
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.remove('hidden');setTimeout(()=>t.classList.add('hidden'),2600)}
function fmtDate(d){if(!d)return '—';return new Date(d+'T12:00:00').toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'})}
function emp(id){return db.employees.find(e=>e.id===id)}
function statusBadge(s){let c=s==='Present'||s==='Approved'||s==='Active'?'green':s==='Rejected'||s==='Absent'||s==='Inactive'?'red':s==='Pending'||s==='Onboarding'||s==='Late'?'amber':'';return `<span class="badge ${c}">${esc(s)}</span>`}
function empty(msg){return `<div class="empty"><div class="empty-icon">◌</div>${esc(msg)}</div>`}
function table(headers,rows,emptyMsg='No records yet.'){if(!rows.length)return empty(emptyMsg);return `<div class="table-wrap"><table><thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.join('')}</tbody></table></div>`}
function showPage(page){document.querySelectorAll('.page').forEach(x=>x.classList.add('hidden'));document.getElementById('page-'+page).classList.remove('hidden');document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));const titles={dashboard:'Dashboard',employees:'Employees',attendance:'Attendance',leaves:'Leave management',company:'Company setup',assistant:'AI HR assistant'};document.getElementById('topTitle').textContent=titles[page];document.getElementById('companySubtitle').textContent=db.company.name||'Your people, at a glance';document.getElementById('sidebar').classList.remove('open');if(page==='employees')document.getElementById('employeeName').focus({preventScroll:true})}
document.querySelectorAll('#nav button').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
document.getElementById('hamb').onclick=()=>document.getElementById('sidebar').classList.toggle('open');
function loadCompanyForm(){companyName.value=db.company.name;companyContact.value=db.company.contact;companyEmail.value=db.company.email;companyLocation.value=db.company.location;departmentInput.value=db.departments.join(', ')}
document.getElementById('companyForm').addEventListener('submit',e=>{e.preventDefault();db.company={name:companyName.value.trim(),contact:companyContact.value.trim(),email:companyEmail.value.trim(),location:companyLocation.value.trim()};db.departments=[...new Set(departmentInput.value.split(',').map(x=>x.trim()).filter(Boolean))];save();toast('Company setup saved')});
document.getElementById('departmentForm').addEventListener('submit',e=>{e.preventDefault();let n=newDepartment.value.trim();if(!n)return;if(db.departments.some(d=>d.toLowerCase()===n.toLowerCase()))return toast('Department already exists');db.departments.push(n);newDepartment.value='';save();toast('Department added')});
function resetEmployeeForm(){employeeForm.reset();employeeId.value='';employeeFormTitle.textContent='Register a new employee';employeeJoinDate.value=today()}
document.getElementById('employeeForm').addEventListener('submit',e=>{e.preventDefault();if(!db.departments.length)return toast('Please add a department in Company setup first');let id=employeeId.value,email=employeeEmail.value.trim().toLowerCase();if(db.employees.some(x=>x.email.toLowerCase()===email&&x.id!==id))return toast('An employee with this email already exists');let data={id:id||uid(),name:employeeName.value.trim(),email,department:employeeDepartment.value,title:employeeTitle.value.trim(),joinDate:employeeJoinDate.value,status:employeeStatus.value};if(id){db.employees=db.employees.map(x=>x.id===id?data:x)}else db.employees.unshift(data);save();resetEmployeeForm();toast(id?'Employee updated':'Employee registered')});
function editEmployee(id){let e=emp(id);if(!e)return;employeeId.value=e.id;employeeName.value=e.name;employeeEmail.value=e.email;employeeDepartment.value=e.department;employeeTitle.value=e.title;employeeJoinDate.value=e.joinDate;employeeStatus.value=e.status;employeeFormTitle.textContent='Edit employee';document.getElementById('employeeName').scrollIntoView({behavior:'smooth',block:'center'})}
function deleteEmployee(id){let e=emp(id);if(!e||!confirm(`Delete ${e.name}? Their attendance and leave records will also be removed.`))return;db.employees=db.employees.filter(x=>x.id!==id);db.attendance=db.attendance.filter(x=>x.employeeId!==id);db.leaves=db.leaves.filter(x=>x.employeeId!==id);save();toast('Employee and related records deleted')}
employeeSearch.addEventListener('input',renderEmployees);employeeFilter.addEventListener('change',renderEmployees);
function renderEmployees(){let q=employeeSearch.value.toLowerCase(),dep=employeeFilter.value;let list=db.employees.filter(e=>(!dep||e.department===dep)&&[e.name,e.email,e.department,e.title].join(' ').toLowerCase().includes(q));employeeCount.textContent=`${list.length} record${list.length===1?'':'s'}`;employeeTable.innerHTML=table(['Employee','Department','Job title','Joined','Status','Actions'],list.map(e=>`<tr><td><strong>${esc(e.name)}</strong><br><span class="muted">${esc(e.email)}</span></td><td>${esc(e.department)}</td><td>${esc(e.title||'—')}</td><td>${fmtDate(e.joinDate)}</td><td>${statusBadge(e.status)}</td><td><div class="actions"><button class="secondary" onclick="editEmployee('${e.id}')">Edit</button><button class="danger" onclick="deleteEmployee('${e.id}')">Delete</button></div></td></tr>`),'No employees match yet. Register your first employee above.')}
function renderDepartments(){departmentList.innerHTML=db.departments.length?`<div class="actions">${db.departments.map((d,i)=>`<span class="badge" style="padding:9px 12px">${esc(d)} <button class="danger" style="padding:2px 7px;margin-left:5px" onclick="removeDepartment(${i})" title="Remove department">×</button></span>`).join('')}</div>`:empty('No departments yet. Add them here or in the organization profile.')}
function removeDepartment(i){let d=db.departments[i];if(db.employees.some(e=>e.department===d))return toast('Move employees to another department before removing this one');if(confirm(`Remove department “${d}”?`)){db.departments.splice(i,1);save()}}
function setOptions(id,items,placeholder,selected){let el=document.getElementById(id),old=selected!==undefined?selected:el.value;el.innerHTML=`<option value="">${esc(placeholder)}</option>`+items.map(x=>{let value=typeof x==='string'?x:x.value,label=typeof x==='string'?x:x.label;return `<option value="${esc(value)}">${esc(label)}</option>`}).join('');if(items.some(x=>(typeof x==='string'?x:x.value)===old))el.value=old}
function renderOptions(){setOptions('employeeDepartment',db.departments,'Choose department');setOptions('employeeFilter',db.departments,'All departments');setOptions('leaveEmployee',db.employees.map(e=>({value:e.id,label:e.name+' — '+e.department})),'Choose employee')}
function renderDashboard(){statEmployees.textContent=db.employees.length;statDepartments.textContent=db.departments.length;let todayRecords=db.attendance.filter(a=>a.date===today());statPresent.textContent=todayRecords.filter(a=>a.status==='Present'||a.status==='Late').length;presentSub.textContent=`${todayRecords.length} of ${db.employees.length} marked today`;statLeaves.textContent=db.leaves.filter(l=>l.status==='Pending').length;setupPrompt.innerHTML=db.company.name?'':`<div class="setup-banner"><h2>Welcome to your new workspace</h2><p>Start by adding your company details and departments. Your dashboard will update as your team uses HCM Lite.</p><button onclick="showPage('company')">Set up your company →</button></div>`;
recentEmployees.innerHTML=table(['Employee','Department','Status'],db.employees.slice(0,5).map(e=>`<tr><td><strong>${esc(e.name)}</strong><br><span class="muted">${esc(e.email)}</span></td><td>${esc(e.department)}</td><td>${statusBadge(e.status)}</td></tr>`),'No employees registered yet.');
todayAttendance.innerHTML=table(['Employee','Status'],db.employees.filter(e=>todayRecords.some(a=>a.employeeId===e.id)).slice(0,5).map(e=>{let a=todayRecords.find(a=>a.employeeId===e.id);return `<tr><td>${esc(e.name)}</td><td>${statusBadge(a.status)}</td></tr>`}),'No attendance marked today.');
recentLeaves.innerHTML=table(['Employee','Dates','Status'],db.leaves.slice().sort((a,b)=>b.createdAt.localeCompare(a.createdAt)).slice(0,5).map(l=>`<tr><td>${esc(emp(l.employeeId)?.name||'Deleted employee')}</td><td>${fmtDate(l.start)} – ${fmtDate(l.end)}</td><td>${statusBadge(l.status)}</td></tr>`),'No leave requests yet.')}
function renderAttendanceEditor(){let date=attendanceDate.value||today();if(!db.employees.length){attendanceEditor.innerHTML=empty('Register employees before marking attendance.');return}attendanceEditor.innerHTML=`<div class="notice">Select a status for each employee, then save attendance for ${fmtDate(date)}. Saving again updates that employee’s status for the selected date.</div>${table(['Employee','Department','Attendance status'],db.employees.map(e=>{let old=db.attendance.find(a=>a.employeeId===e.id&&a.date===date);return `<tr><td><strong>${esc(e.name)}</strong><br><span class="muted">${esc(e.email)}</span></td><td>${esc(e.department)}</td><td><select class="attendance-status" data-employee="${e.id}" style="padding:8px;border:1px solid var(--line);border-radius:8px"><option ${!old?'selected':''} value="">Not marked</option>${['Present','Absent','Late','On leave'].map(s=>`<option ${old?.status===s?'selected':''}>${s}</option>`).join('')}</select></td></tr>`}),'No employees to mark.')}<div style="margin-top:15px"><button onclick="saveAttendance()">Save attendance</button></div>`}
function saveAttendance(){let date=attendanceDate.value;if(!date)return toast('Choose an attendance date');document.querySelectorAll('.attendance-status').forEach(s=>{let id=s.dataset.employee;db.attendance=db.attendance.filter(a=>!(a.employeeId===id&&a.date===date));if(s.value)db.attendance.push({id:uid(),employeeId:id,date,status:s.value,updatedAt:new Date().toISOString()})});save();toast('Attendance saved')}
function renderAttendanceTable(){let q=attendanceSearch.value.toLowerCase(),date=attendanceHistoryDate.value;let list=db.attendance.filter(a=>(!date||a.date===date)&&((emp(a.employeeId)?.name||'').toLowerCase().includes(q))).sort((a,b)=>b.date.localeCompare(a.date));attendanceCount.textContent=`${list.length} record${list.length===1?'':'s'}`;attendanceTable.innerHTML=table(['Date','Employee','Department','Status'],list.map(a=>`<tr><td>${fmtDate(a.date)}</td><td>${esc(emp(a.employeeId)?.name||'Unknown')}</td><td>${esc(emp(a.employeeId)?.department||'—')}</td><td>${statusBadge(a.status)}</td></tr>`),'No attendance records found.')}
attendanceDate.value=today();attendanceDate.addEventListener('change',renderAttendanceEditor);attendanceSearch.addEventListener('input',renderAttendanceTable);attendanceHistoryDate.value='';attendanceHistoryDate.addEventListener('change',renderAttendanceTable);
document.getElementById('leaveForm').addEventListener('submit',e=>{e.preventDefault();if(!emp(leaveEmployee.value))return toast('Register an employee first');if(leaveEnd.value<leaveStart.value)return toast('End date must be on or after start date');db.leaves.unshift({id:uid(),employeeId:leaveEmployee.value,type:leaveType.value,start:leaveStart.value,end:leaveEnd.value,reason:leaveReason.value.trim(),status:'Pending',createdAt:new Date().toISOString()});save();leaveForm.reset();toast('Leave request submitted')});
leaveFilter.addEventListener('change',renderLeaves);
function decideLeave(id,status){let l=db.leaves.find(x=>x.id===id);if(!l)return;l.status=status;l.reviewedAt=new Date().toISOString();save();toast('Leave '+status.toLowerCase())}
function renderLeaves(){let f=leaveFilter.value,list=db.leaves.filter(l=>!f||l.status===f);leaveCount.textContent=`${list.length} request${list.length===1?'':'s'}`;leaveTable.innerHTML=table(['Employee','Type / reason','Dates','Days','Status','Decision'],list.map(l=>{let days=Math.round((new Date(l.end+'T12:00:00')-new Date(l.start+'T12:00:00'))/86400000)+1;return `<tr><td><strong>${esc(emp(l.employeeId)?.name||'Unknown')}</strong></td><td>${esc(l.type)}<br><span class="muted">${esc(l.reason||'No reason provided')}</span></td><td>${fmtDate(l.start)}<br>${fmtDate(l.end)}</td><td>${days}</td><td>${statusBadge(l.status)}</td><td>${l.status==='Pending'?`<div class="actions"><button style="padding:7px 9px" onclick="decideLeave('${l.id}','Approved')">Approve</button><button class="danger" style="padding:7px 9px" onclick="decideLeave('${l.id}','Rejected')">Reject</button>`:'—'}</td></tr>`}),'No leave requests yet.')}
function renderAll(){document.getElementById('companySubtitle').textContent=db.company.name||'Your people, at a glance';loadCompanyForm();renderOptions();renderDepartments();renderEmployees();renderDashboard();renderAttendanceEditor();renderAttendanceTable();renderLeaves()}
function answerQuestion(q){let s=q.toLowerCase(),todayList=db.attendance.filter(a=>a.date===today()),pending=db.leaves.filter(l=>l.status==='Pending');if(/how many|count|total|number/.test(s)&&/employee|staff|people|worker/.test(s))return `There ${db.employees.length===1?'is':'are'} ${db.employees.length} registered employee${db.employees.length===1?'':'s'} in this workspace.`;if(/department/.test(s)&&(/summary|each|breakdown|how many|count/.test(s))){if(!db.departments.length)return 'No departments have been set up yet. Add departments in Company setup.';return 'Department summary (registered employees):\n'+db.departments.map(d=>`• ${d}: ${db.employees.filter(e=>e.department===d).length}`).join('\n')}if(/department/.test(s)&&/list|which|what/.test(s))return db.departments.length?'Departments: '+db.departments.join(', '):'No departments have been created yet.';if(/present|attendance|who came/.test(s)&&/today|present|attendance/.test(s)){let present=todayList.filter(a=>a.status==='Present'||a.status==='Late');return `For ${fmtDate(today())}, attendance is marked for ${todayList.length} of ${db.employees.length} employees.\nPresent or late (${present.length}): ${present.length?present.map(a=>emp(a.employeeId)?.name+' — '+a.status).join(', '):'No one marked present yet.'}`}if(/absent/.test(s)){let absent=todayList.filter(a=>a.status==='Absent');return `Employees marked absent today (${absent.length}): ${absent.length?absent.map(a=>emp(a.employeeId)?.name).join(', '):'None recorded.'}`}if(/pending|awaiting/.test(s)&&/leave|request/.test(s))return `There ${pending.length===1?'is':'are'} ${pending.length} pending leave request${pending.length===1?'':'s'}.`+(pending.length?'\n'+pending.map(l=>`• ${emp(l.employeeId)?.name||'Unknown'}: ${l.type}, ${fmtDate(l.start)} to ${fmtDate(l.end)}`).join('\n'):'');if(/leave/.test(s)&&/approved|rejected/.test(s)){let status=/reject/.test(s)?'Rejected':'Approved',ls=db.leaves.filter(l=>l.status===status);return `${status} leave requests: ${ls.length}.\n`+(ls.length?ls.map(l=>`• ${emp(l.employeeId)?.name||'Unknown'}: ${fmtDate(l.start)} to ${fmtDate(l.end)}`).join('\n'):'No matching records.')}if(/leave/.test(s)&&/how many|count|total/.test(s))return `There are ${db.leaves.length} total leave requests: ${pending.length} pending, ${db.leaves.filter(l=>l.status==='Approved').length} approved, and ${db.leaves.filter(l=>l.status==='Rejected').length} rejected.`;if(/company|organization|organisation/.test(s))return db.company.name?`Company: ${db.company.name}\nContact: ${db.company.contact||'Not provided'}\nEmail: ${db.company.email||'Not provided'}\nLocation: ${db.company.location||'Not provided'}`:'Company setup has not been completed yet.';if(/help|what can you|what do you/.test(s))return 'I can answer questions about employee counts, employee names, department totals, today’s attendance, absent employees, leave request totals/statuses, and the company profile. Ask a specific question to get started.';if(/who|list|show|name/.test(s)&&/employee|staff|people/.test(s))return db.employees.length?'Registered employees:\n'+db.employees.map(e=>`• ${e.name} — ${e.department} (${e.status})`).join('\n'):'There are no registered employees yet.';return 'I could not match that to a supported question. Try asking about employee count, department summary, who is present today, absent employees, pending leaves, approved leaves, or company details. I only use records saved in this workspace.'}
function sendChat(q){if(!q.trim())return;let log=chatLog;log.insertAdjacentHTML('beforeend',`<div class="bubble me">${esc(q)}</div><div class="bubble bot">${esc(answerQuestion(q))}</div>`);chatInput.value='';log.scrollTop=log.scrollHeight}
chatForm.addEventListener('submit',e=>{e.preventDefault();sendChat(chatInput.value)});document.querySelectorAll('[data-question]').forEach(b=>b.addEventListener('click',()=>sendChat(b.dataset.question)));
employeeJoinDate.value=today();
renderAll();
</script>
</body>
</html>
